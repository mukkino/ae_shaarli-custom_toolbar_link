description="Adds one configurable semantic-position toolbar link to Shaarli. Configure text, URL, tooltip, position, target, colour style and formatting from this plugin's parameters."
parameters="CUSTOM_LINK_TEXT;CUSTOM_LINK_URL;CUSTOM_LINK_TOOLTIP;CUSTOM_LINK_POSITION;CUSTOM_LINK_STYLE;CUSTOM_LINK_WEIGHT;CUSTOM_LINK_ITALIC;CUSTOM_LINK_UNDERLINE;CUSTOM_LINK_CASE;CUSTOM_LINK_SIZE;CUSTOM_LINK_TARGET"
parameter.CUSTOM_LINK_TEXT="Visible link text. Example: ← Alterego.cc"
parameter.CUSTOM_LINK_URL="Destination URL. Example: https://alterego.cc/"
parameter.CUSTOM_LINK_TOOLTIP="Tooltip/title shown on hover. Leave empty to reuse the visible text."
parameter.CUSTOM_LINK_POSITION="Semantic position: before-home, after-home, before-shaare, after-shaare, before-tools, after-tools, main-first, main-last, right-first, right-last, center, or native."
parameter.CUSTOM_LINK_STYLE="Colour/style preset: theme, auto, white, bold-white, black, dark, light, muted-light, muted-dark, blue, cyan, green, yellow, orange, red, purple, button, button-light, or button-dark."
parameter.CUSTOM_LINK_WEIGHT="Font weight: theme, normal, bold, lighter, bolder, or 100/200/300/400/500/600/700/800/900."
parameter.CUSTOM_LINK_ITALIC="Font style: theme, normal, or italic."
parameter.CUSTOM_LINK_UNDERLINE="Underline: theme, none, hover, or always."
parameter.CUSTOM_LINK_CASE="Text case: theme, normal, uppercase, lowercase, or capitalize."
parameter.CUSTOM_LINK_SIZE="Text size: theme, small, normal, or large."
parameter.CUSTOM_LINK_TARGET="Open behaviour: same or new."
